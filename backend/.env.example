# Copy to .env for local runs. On Vercel add these under Settings → Environment Variables.

# Same Supabase project as before: Connect → Transaction pooler string (port 6543), with your DB password
DATABASE_URL=postgresql://postgres.btmqblzossuakdqyujrf:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-player-session-secret
SERVER_SECRET=change-me-shared-with-dedicated-servers
CRON_SECRET=change-me-vercel-cron

# Google sign-in / Play Games (Google Cloud console → APIs & Services → Credentials)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Facebook Login (developers.facebook.com → your app → Settings → Basic)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Play purchase verification (service account with "View financial data" in Play Console)
ANDROID_PACKAGE_NAME=com.yourstudio.stormdrop
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Public contact shown on legal pages
SUPPORT_EMAIL=support@example.com
