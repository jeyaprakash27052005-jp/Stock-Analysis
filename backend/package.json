{
  "name": "stormdrop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Stormdrop Royale backend: accounts, inventory, store, missions, pass, social, matchmaking, leaderboards.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/local.js",
    "start": "node src/local.js",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js",
    "check": "node --check src/app.js && node scripts/smoke.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
