# Same value as SERVER_SECRET in the backend (Vercel env vars)
STORMDROP_SECRET=change-me-shared-with-dedicated-servers
# Backend base URL
STORMDROP_API=https://your-project.vercel.app/api
# Public IP / DNS name of this VM that phones connect to
STORMDROP_HOST=203.0.113.10
# Matchmaking region this VM serves: IND, SEA, ME, EU, NA, SA
STORMDROP_REGION=IND
